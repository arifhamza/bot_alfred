# Template for testing src/main.py locally on your own computer only.
# The LIVE bot (webhook_app.py) does NOT use this file - its credentials
# go directly into the PythonAnywhere WSGI configuration file instead
# (see README.md, section 3E). Never commit a real ".env" file to git.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_USER_ID=123456789
IGNORE_COOLDOWN=1
DRY_RUN=1
