# This file is a TEMPLATE for local testing only. It is not used in
# production - GitHub Actions uses encrypted repository Secrets instead
# (see README.md, "Entering your Telegram credentials").
#
# If you want to test the bot on your own computer before deploying:
#   1. Copy this file to a new file named ".env"
#   2. Fill in your real values in ".env"
#   3. Never commit ".env" to git (it's already in .gitignore)
#   4. Before running, load it into your shell, e.g. on macOS/Linux:
#        export $(grep -v '^#' .env | xargs)
#      or use a tool like `python-dotenv` / `direnv` if you prefer.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_USER_ID=123456789
TIMEZONE=America/New_York
DIGEST_HOUR=9
FORCE_RUN=1
DRY_RUN=1
